{
  "apphosting": {
    "backendId": "camisa-vetor-main",
    "rootDir": ".",
    "alwaysDeployFromSource": true
  },
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Camisa Vetor",
        "supportEmail": "tchantchasmidias@gmail.com"
      }
    }
  },
  "functions": [
    {
      "source": ".firebase\\camisa-vetor-app\\functions",
      "codebase": "firebase-frameworks-camisa-vetor-app"
    }
  ]
}
